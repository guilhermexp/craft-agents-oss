+def _log(message: str) -> None:
+    ts = time.strftime("%Y-%m-%d %H:%M:%S", time.localtime())
+    print(f"[{ts}] {message}", flush=True)
+
+
+def _write_page_debug(page, out_dir: Path, label: str) -> None:
+    """Write safe debug artifacts showing where Meet automation is stuck."""
+    safe_label = re.sub(r"[^a-zA-Z0-9_.-]+", "-", label).strip("-") or "debug"
+    try:
+        info = page.evaluate(
+            r"""
+            () => {
+              const text = (document.body && document.body.innerText || '').slice(0, 4000);
+              const buttons = Array.from(document.querySelectorAll('button'))
+                .map((b) => ({ text: (b.innerText || '').trim(), aria: b.getAttribute('aria-label') || '', visible: !!(b.offsetWidth || b.offsetHeight || b.getClientRects().length) }))
+                .filter((b) => b.text || b.aria)
+                .slice(0, 80);
+              return { url: location.href, title: document.title, text, buttons };
+            }
+            """
+        )
+        (out_dir / f"debug-{safe_label}.json").write_text(json.dumps(info, indent=2), encoding="utf-8")
+        _log(f"debug {safe_label}: title={info.get('title')!r} url={info.get('url')!r} buttons={len(info.get('buttons') or [])}")
+    except Exception as e:
+        _log(f"debug {safe_label} failed: {e}")
+    try:
+        page.screenshot(path=str(out_dir / f"debug-{safe_label}.png"), full_page=True, timeout=5000)
+    except Exception as e:
+        _log(f"debug screenshot {safe_label} failed: {e}")
+
