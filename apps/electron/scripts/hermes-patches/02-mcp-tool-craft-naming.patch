     return re.sub(r"[^A-Za-z0-9_]", "_", str(value or ""))
 
 
+def _mcp_tool_registry_name(server_name: str, tool_name: str) -> str:
+    """Return the Hermes registry name for an MCP tool.
+
+    Craft's session tools are already canonicalized across Craft/Pi as
+    ``mcp__session__<tool>``. Preserve that namespace when Hermes is embedded
+    in Craft so the same permission, prerequisite, and UI paths recognize the
+    tool as a native Craft session tool.
+    """
+    safe_tool_name = sanitize_mcp_name_component(tool_name)
+    if server_name in {"craft-session", "session"}:
+        return f"mcp__session__{safe_tool_name}"
+    if server_name in {"craft-sources", "sources"} and "__" in safe_tool_name:
+        return f"mcp__{safe_tool_name}"
+    safe_server_name = sanitize_mcp_name_component(server_name)
+    return f"mcp_{safe_server_name}_{safe_tool_name}"
+
