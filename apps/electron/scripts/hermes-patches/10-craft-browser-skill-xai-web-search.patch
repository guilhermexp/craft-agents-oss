+def _extract_xai_response_text(payload: Dict[str, Any]) -> str:
+    text = str(payload.get("output_text") or "").strip()
+    if text:
+        return text
+
+    parts: List[str] = []
+    for item in payload.get("output") or []:
+        if not isinstance(item, dict):
+            continue
+        for content in item.get("content") or []:
+            if not isinstance(content, dict):
+                continue
+            value = content.get("text") or content.get("content")
+            if isinstance(value, str) and value.strip():
+                parts.append(value.strip())
+    return "\n".join(parts).strip()
+
+
+def _normalize_xai_citation(citation: Any, position: int) -> Optional[Dict[str, Any]]:
+    if isinstance(citation, str):
+        url = citation.strip()
+        if not url:
+            return None
+        return {
+            "title": url,
+            "url": url,
+            "description": "",
+            "position": position,
+        }
+    if isinstance(citation, dict):
+        url = str(citation.get("url") or citation.get("href") or "").strip()
+        if not url:
+            return None
+        title = str(citation.get("title") or url).strip()
+        description = str(
+            citation.get("description")
+            or citation.get("snippet")
+            or citation.get("text")
+            or ""
+        ).strip()
+        return {
+            "title": title,
+            "url": url,
+            "description": description,
+            "position": position,
+        }
+    return None
+
+
+def _extract_xai_citations(payload: Dict[str, Any]) -> List[Any]:
+    citations = payload.get("citations")
+    if isinstance(citations, list):
+        return citations
+
+    found: List[Any] = []
+    for item in payload.get("output") or []:
+        if not isinstance(item, dict):
+            continue
+        for content in item.get("content") or []:
+            if not isinstance(content, dict):
+                continue
+            annotations = content.get("annotations")
+            if not isinstance(annotations, list):
+                continue
+            for annotation in annotations:
+                if isinstance(annotation, dict) and (annotation.get("url") or annotation.get("href")):
+                    found.append(annotation)
+    return found
+
+
