+    # Fallback for Meet UI/localization rewrites: inspect visible buttons in JS
+    # and click anything whose text/aria label looks like a join/request action.
+    try:
+        result = page.evaluate(
+            r"""
+            () => {
+              const askRe = /(ask|request|pedir|solicitar|demander).{0,30}(join|particip|entrar|unirse)|(^|\b)(join|participar|entrar|unirse|rejoindre)(\b|$)/i;
+              const negativeRe = /(leave|sair|encerrar|cancel|cancelar|deny|negar)/i;
+              const buttons = Array.from(document.querySelectorAll('button'));
+              for (const button of buttons) {
+                const text = `${button.innerText || ''} ${button.getAttribute('aria-label') || ''}`.trim();
+                const visible = !!(button.offsetWidth || button.offsetHeight || button.getClientRects().length);
+                if (!visible || !text || negativeRe.test(text)) continue;
+                if (askRe.test(text)) {
+                  button.click();
+                  return { clicked: true, text };
+                }
+              }
+              return { clicked: false, buttons: buttons.map((b) => `${b.innerText || ''} ${b.getAttribute('aria-label') || ''}`.trim()).filter(Boolean).slice(0, 40) };
