+def test_web_search_falls_back_to_xai_responses_without_exposing_key(monkeypatch):
+    class BrokenProvider:
+        name = "broken"
+
+        def supports_search(self):
+            return True
+
+        def search(self, _query, _limit):
+            return {"success": False, "error": "primary backend down"}
+
+    captured = {}
+
+    def fake_post(url, headers, json, timeout):
+        captured["url"] = url
