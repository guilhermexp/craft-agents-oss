+import json
+
+from model_tools import handle_function_call
+from tools.registry import registry
+
+
+def test_legacy_browser_navigate_routes_to_craft_browser_tool_when_available():
+    captured = {}
+
+    def _handler(args, **_kwargs):
+        captured["args"] = args
+        return json.dumps({"ok": True, "args": args})
+
+    registry.register(
+        name="mcp__session__browser_tool",
+        toolset="mcp-craft-session",
+        schema={
+            "name": "mcp__session__browser_tool",
+            "description": "Craft browser tool",
+            "parameters": {"type": "object", "properties": {"command": {}}},
+        },
+        handler=_handler,
+        override=True,
+    )
+    try:
+        result = json.loads(
+            handle_function_call(
+                "browser_navigate",
+                {"url": "https://example.com"},
+                task_id="craft-session-1",
+            )
+        )
+    finally:
+        registry.deregister("mcp__session__browser_tool")
+
+    assert result["ok"] is True
+    assert captured["args"] == {"command": ["navigate", "https://example.com"]}
+
+
+def test_legacy_browser_navigate_does_not_treat_session_tab_paths_as_urls():
+    captured = {}
+
+    def _handler(args, **_kwargs):
+        captured["args"] = args
+        return json.dumps({"ok": True})
+
+    registry.register(
+        name="mcp__session__browser_tool",
+        toolset="mcp-craft-session",
+        schema={
+            "name": "mcp__session__browser_tool",
+            "description": "Craft browser tool",
+            "parameters": {"type": "object", "properties": {"command": {}}},
+        },
+        handler=_handler,
+        override=True,
+    )
+    try:
+        handle_function_call(
+            "browser_navigate",
+            {"url": "900b5bb2-craft-session/tabs"},
+            task_id="craft-session-1",
+        )
+    finally:
+        registry.deregister("mcp__session__browser_tool")
+
+    assert captured["args"] == {"command": ["navigate", "900b5bb2-craft-session/tabs"]}
