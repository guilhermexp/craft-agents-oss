@@ -494,6 +494,75 @@ def _compute_tool_definitions(
 # so if something slips through, the LLM sees a sensible message.
 _AGENT_LOOP_TOOLS = {"todo", "memory", "session_search", "delegate_task"}
 _READ_SEARCH_TOOLS = {"read_file", "search_files"}
+_CRAFT_BROWSER_TOOL_NAME = "mcp__session__browser_tool"
+
+
+def _craft_browser_command_for_legacy_tool(
+    function_name: str,
+    function_args: Dict[str, Any],
+) -> Optional[List[str]]:
+    """Translate legacy Hermes browser_* calls into Craft browser_tool argv.
+
+    Craft embeds Hermes with a session-scoped MCP browser tool. When that tool
+    is registered, it is the authoritative browser surface; routing legacy
+    browser_* calls through it prevents Hermes' standalone browser backend from
+    interpreting Craft session/tab identifiers as HTTP URLs.
+    """
+    if not function_name.startswith("browser_") or function_name == "browser_tool":
+        return None
+
+    if registry.get_entry(_CRAFT_BROWSER_TOOL_NAME) is None:
+        return None
+
+    if function_name == "browser_navigate":
+        url = str(function_args.get("url") or "").strip()
+        return ["navigate", url] if url else ["navigate"]
+    if function_name == "browser_snapshot":
+        return ["snapshot"]
+    if function_name == "browser_click":
+        ref = str(
+            function_args.get("ref")
+            or function_args.get("element")
+            or function_args.get("element_id")
+            or ""
+        ).strip()
+        return ["click", ref] if ref else ["click"]
+    if function_name == "browser_type":
+        text = str(function_args.get("text") or function_args.get("value") or "").strip()
+        return ["type", text] if text else ["type"]
+    if function_name == "browser_press":
+        key = str(function_args.get("key") or "").strip()
+        return ["key", key] if key else ["key"]
+    if function_name == "browser_scroll":
+        direction = str(function_args.get("direction") or "down").strip()
+        amount = function_args.get("amount")
+        command = ["scroll", direction or "down"]
+        if amount is not None:
+            command.append(str(amount))
+        return command
+    if function_name == "browser_back":
+        return ["back"]
+    if function_name == "browser_console":
+        command = ["console"]
+        limit = function_args.get("limit")
+        level = function_args.get("level")
+        if limit is not None:
+            command.append(str(limit))
+        if level is not None:
+            command.append(str(level))
+        return command
+
+    return None
+
+
+def _normalize_craft_browser_tool_call(
+    function_name: str,
+    function_args: Dict[str, Any],
+) -> Tuple[str, Dict[str, Any]]:
+    command = _craft_browser_command_for_legacy_tool(function_name, function_args)
+    if command is None:
+        return function_name, function_args
+    return _CRAFT_BROWSER_TOOL_NAME, {"command": command}
 
 
 # =========================================================================
@@ -764,6 +833,11 @@ def handle_function_call(
     Returns:
         Function result as a JSON string.
     """
+    function_name, function_args = _normalize_craft_browser_tool_call(
+        function_name,
+        function_args,
+    )
+
     # Coerce string arguments to their schema-declared types (e.g. "42"→42)
     function_args = coerce_tool_args(function_name, function_args)
 
