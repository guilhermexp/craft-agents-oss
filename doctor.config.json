{
  "$schema": "https://react.doctor/schema/config.json",
  "ignore": {
    "files": [
      "apps/electron/resources/**",
      "apps/electron/eslint-rules/**",
      "apps/electron/src/main/shims/**",
      "**/dist/**",
      "**/bridge-mcp-server/**",
      "**/.github/**"
    ]
  },
  "rules": {
    "deslop/unused-file": "off",
    "deslop/unused-export": "off",
    "deslop/unused-dependency": "off",
    "deslop/unused-dev-dependency": "off",
    "deslop/circular-dependency": "off",

    "react-doctor/no-adjust-state-on-prop-change": "off",
    "react-doctor/no-reset-all-state-on-prop-change": "off",
    "react-doctor/no-event-handler": "off",
    "react-doctor/no-effect-event-handler": "off",
    "react-doctor/exhaustive-deps": "off",
    "react-doctor/no-derived-state": "off",
    "react-doctor/no-derived-state-effect": "off",
    "react-doctor/no-derived-useState": "off",
    "react-doctor/no-cascading-set-state": "off",
    "react-doctor/no-chain-state-updates": "off",
    "react-doctor/no-mirror-prop-effect": "off",
    "react-doctor/no-effect-chain": "off",
    "react-doctor/no-did-update-set-state": "off",
    "react-doctor/no-fetch-in-effect": "off",
    "react-doctor/no-prop-callback-in-effect": "off",
    "react-doctor/no-pass-data-to-parent": "off",
    "react-doctor/no-pass-live-state-to-parent": "off",
    "react-doctor/rerender-state-only-in-handlers": "off",
    "react-doctor/no-initialize-state": "off",

    "react-doctor/no-giant-component": "off",
    "react-doctor/no-multi-comp": "off",
    "react-doctor/prefer-useReducer": "off",
    "react-doctor/no-many-boolean-props": "off",
    "react-doctor/only-export-components": "off",
    "react-doctor/no-render-in-render": "off",

    "react-doctor/no-danger": "off",
    "react-doctor/no-array-index-as-key": "off",
    "react-doctor/prefer-tag-over-role": "off",
    "react-doctor/no-static-element-interactions": "off",
    "react-doctor/click-events-have-key-events": "off",
    "react-doctor/async-await-in-loop": "off",
    "react-doctor/async-defer-await": "off",
    "react-doctor/js-set-map-lookups": "off",
    "react-doctor/js-index-maps": "off",
    "react-doctor/use-lazy-motion": "off",
    "react-doctor/no-layout-property-animation": "off",
    // Misfires on the codebase's correct React unmount/cancel guard idiom
    // (`finally { if (!cancelled) setLoading(false) }` / mountedRef) used to fix
    // set-state-after-unmount; the guarded reset DOES run on reject, so the flag is never stuck.
    "react-doctor/no-loading-flag-reset-outside-finally": "off",
    // Heuristic over-fires on canonical AnimatePresence usage where the boundary is gated by a
    // stable structural condition and the animated child by an independent runtime toggle, so the
    // boundary correctly outlives the child across exit animations.
    "react-doctor/motion-animate-presence-must-outlive-child": "off",
    "react-doctor/no-autofocus": "off",
    "react-doctor/rendering-hydration-mismatch-time": "off",
    "react-doctor/client-passive-event-listeners": "off",
    "react-doctor/rerender-lazy-ref-init": "off",
    "react-doctor/jsx-no-jsx-as-prop": "off",
    "react-doctor/no-inline-exhaustive-style": "off",
    "react-doctor/no-usememo-simple-expression": "off",

    "react-doctor/no-noninteractive-tabindex": "off",
    "react-doctor/media-has-caption": "off",
    "react-doctor/rendering-usetransition-loading": "off",
    "react-doctor/prefer-html-dialog": "off",
    "react-doctor/no-long-transition-duration": "off",
    "react-doctor/js-length-check-first": "off",
    "react-doctor/advanced-event-handler-refs": "off"
  }
}
